# Copy to .env and fill in real values. NEVER commit the real .env file.

NODE_ENV=development
PORT=8002

# Database (MONGO_URL is REQUIRED in production; the app refuses to start without it)
MONGO_URL=
MONGO_URL_LOCAL=mongodb://127.0.0.1:27017/SchoolDB?directConnection=true

# Secrets (use long random values, different for each)
JWT_SECRET=
JWT_REFRESH_SECRET=
REFRESH_TOKEN_SECRET=
REFRESH_TOKEN_EXPIRY=7d
SESSION_SECRET=

# CORS: comma-separated frontend origins (trailing slashes are ignored)
CORS_WHITELIST=
CLIENT_URL=
STUDENT_URL=

# Password-reset rate limit per IP per 15 minutes (default 10)
RESET_RATE_LIMIT_MAX=10

# Email
MAIL_CLIENT_SERVICE=
MAIL_CLIENT_USER=
MAIL_CLIENT_PASS=

# SMS
SMS_URL=
SMS_API_KEY=

# Firebase Storage
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
